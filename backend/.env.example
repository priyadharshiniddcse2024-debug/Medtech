# Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=development
# Never enable debug outside local development (Werkzeug debugger allows remote code execution)
FLASK_DEBUG=false
# Interface the dev server binds to (use 0.0.0.0 only when you intend to expose it)
HOST=127.0.0.1

# Optional: seeds a demo user in development only
# DEMO_USER_PASSWORD=choose-a-strong-demo-password

# Database Configuration
DATABASE_URL=sqlite:///maternal_health.db

# CORS Configuration (comma-separated list of allowed origins, wildcards are ignored)
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Port Configuration (optional, defaults to 5000)
PORT=5000
